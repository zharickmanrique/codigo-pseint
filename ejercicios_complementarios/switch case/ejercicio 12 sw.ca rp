Algoritmo ejercicio_12
	// Un parqueadero necesita calcular el cobro según el tipo de vehículo que ingresa. El usuario podrá seleccionar automóvil, motocicleta, camioneta o bicicleta. Según la selección, el programa deberá solicitar el tiempo de permanencia y calcular el valor a pagar utilizando la tarifa correspondiente por hora.
	Definir tipovehiculo Como Caracter;
	Definir horas, valortotal Como Real;
	
	Escribir " BIENVENIDO-PARQUEADERO"
	Escribir " selecciona el tipo de vehiculo que ingresa (A= automovil, M= motocicleta, C= camioneta, B= bicicleta)";
	Leer tipovehiculo;
	Escribir "ingrese el tiempo de permanencia";
	Leer horas;
	
	Segun tipovehiculo Hacer
		caso "A":
			valortotal<-horas * 4000;
			Escribir " el valor total a pagar por el automovil es de:" + ConvertirATexto(valortotal);
		Caso "M":
			valortotal<-horas * 3000;
			Escribir " el valor total a pagar por la motocicleta es de:" + ConvertirATexto(valortotal);
		Caso "C":
			valortotal<-horas * 5000;
			Escribir " el valor total a pagar por la camioneta es de:" + ConvertirATexto(valortotal);
		Caso "B":
		valortotal<-horas * 2000;
			Escribir " el valor total a pagar por la bicicleta es de:" + ConvertirATexto(valortotal);
		De Otro Modo:
			Escribir "opcion no valida";
	Fin Segun
	
	
FinAlgoritmo

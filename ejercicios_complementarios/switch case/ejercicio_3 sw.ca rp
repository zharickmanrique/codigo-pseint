Algoritmo ejercicio_3
	//Una institución educativa necesita un programa en el que el usuario ingrese un número del 1 al 7. El sistema deberá mostrar el día de la semana correspondiente, considerando que el número 1 representa el lunes y el número 7 representa el domingo.
	Definir num Como Entero;
	
	Escribir " ingrese un numero del 1 al 7";
	Leer num;
	
	Segun num Hacer
		caso 1:
			Escribir " corresponde al dia lunes";
		caso 2:
			Escribir " corresponde al dia martes";
		caso 3:
			Escribir " corresponde al dia miercoles";
		caso 4:
			Escribir " corresponde al dia jueves";
		caso 5:
			Escribir " corresponde al dia viernes";
		caso 6:
			Escribir " corresponde al dia sabado";
	    caso 7:
			Escribir " corresponde al dia domingo";
		De Otro Modo:
			Escribir " ERROR, numero invalido;
	Fin Segun
	
FinAlgoritmo

Algoritmo ejercicio_18
	// Una empresa de servicios públicos necesita calcular el valor de una factura según el servicio utilizado. El usuario podrá seleccionar entre agua, energía eléctrica o gas. Después, deberá ingresar la cantidad de unidades consumidas. Según el servicio seleccionado, el programa deberá multiplicar el consumo por la tarifa correspondiente y mostrar el valor total de la factura.
	Definir servicio Como Caracter;
	Definir consumo, valortotal, tarifa Como Real;
	
	Escribir " EMPRESA SERVICIOS PUBLICOS";
	Escribir "seleccione el servicio (A= agua, E= energia electrica, G= gas)";
	Leer servicio;
	
	Segun servicio Hacer
		caso "A":
			Escribir "ingrese las unidades de agua consumidas:";
            Leer consumo;
			tarifa<-5000
            valortotal<-consumo * tarifa;
            Escribir "la tarifa es de: " + ConvertirATexto(tarifa);
            Escribir "el valor total de la factura es: " + ConvertirATexto(valortotal);
		Caso "E":
			Escribir "ingrese las unidades de agua consumidas:";
            Leer consumo;
			tarifa<-6000
            valortotal<-consumo * tarifa;
            Escribir "la tarifa es de: " + ConvertirATexto(tarifa);
            Escribir "el valor total de la factura es: " + ConvertirATexto(valortotal);
		Caso "G":
			Escribir "ingrese las unidades de agua consumidas:";
            Leer consumo;
			tarifa<-3000;
            valortotal<-consumo * tarifa;
            Escribir "la tarifa es de: " + ConvertirATexto(tarifa);
            Escribir "el valor total de la factura es: " + ConvertirATexto(valortotal);
		De Otro Modo:
			Escribir " servicio no valido";
	Fin Segun
	
	
	
FinAlgoritmo

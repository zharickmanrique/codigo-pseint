Algoritmo ejercicio_2
	//Un profesor necesita una calculadora que permita realizar una operación matemática entre dos números ingresados por el usuario. El programa debe permitir elegir entre suma, resta, multiplicación y división. Según la operación seleccionada, deberá mostrar el resultado.
	Definir num1, num2 Como real;
	Definir suma, resta, multiplicacion, division Como Real;
	Definir operacion como caracter;
	
	Escribir " CALCULADORA";
	
	Escribir " elige que operacion matematica deseas utilizar ( S= suma, R= resta, M= multiplicacion, D= division)";
	Leer operacion;
	Escribir " ingresa un numero";
	Leer num1;
	Escribir "ingresa otro numero";
	Leer num2;
	
	Segun operacion Hacer
		caso "S":
			suma<-num1 + num2
			Escribir " el resultado de la suma de los numeros es: " + ConvertirATexto(suma);
		Caso "R":
			resta<-num1 - num2
			Escribir " el resultado de la resta de los numeros es: " + ConvertirATexto(resta);
		Caso "M":
			multiplicacion<-num1 * num2
			Escribir " el resultado de la multiplicacion de los numeros es: " + ConvertirATexto(multiplicacion);
		caso "D":
			division<-num1 / num2
			Escribir " el resultado de la division de los numeros es:" + ConvertirATexto(division);
			
		De Otro Modo:
			Escribir " operacion invalida"
	Fin Segun
	
FinAlgoritmo

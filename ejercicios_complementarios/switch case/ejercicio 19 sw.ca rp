Algoritmo ejercicio_19
	// Una cafetería necesita un programa para registrar los pedidos de sus clientes. El usuario deberá seleccionar entre café, jugo natural, sándwich o empanada. Luego, deberá ingresar la cantidad que desea comprar. Según el producto seleccionado, el programa deberá calcular el subtotal, aplicar un descuento del 10 % cuando la compra supere los $50.000 y mostrar el valor final que debe pagar el cliente.
	Definir producto Como Caracter;
	Definir cant Como Entero;
	Definir precio, subtotal, descuento, valorfinal Como Real;
	
	Escribir " CAFETERIA"
	Escribir " seleccione el producto que desee (C= cafe, J= jugo natural, S= sandwich, E= empanada):";
	Leer producto;
	
	Segun producto Hacer
		caso "C":
			Escribir " ingrese la cantidad que desea comprar";
			Leer cant;
			precio<-3000;
			subtotal<-cant * precio;
			Escribir "el subtotal del producto es: $" + ConvertirATexto(subtotal);
			Si subtotal > 50000 Entonces
				descuento<-subtotal * 0.10;
			SiNo
				descuento<-0;
			Fin Si
			valorfinal<-subtotal - descuento;
			Escribir " el descuento es:" + ConvertirATexto(descuento);
			Escribir " el valor final que debe pagar el cliente es:" + ConvertirATexto(valorfinal);

		Caso "J":

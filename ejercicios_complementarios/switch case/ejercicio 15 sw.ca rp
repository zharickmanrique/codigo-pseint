Algoritmo ejercicio_15
	// Un hotel necesita un programa para que sus clientes seleccionen el tipo de habitación que desean reservar. Las opciones son sencilla, doble, familiar y suite. Según la opción elegida, el programa deberá solicitar el número de noches y calcular el costo total de la reserva según la tarifa por noche.
	Definir tipohab Como Caracter;
	Definir numNoches como entero;
	Definir costoTotal Como Real;
	
	Escribir " seleccione el tipo de habitacion que desea reservar (D= doble, F= familiar, S= suite)";
	Leer tipohab;
	
	Segun tipohab Hacer
		caso "D":
			Escribir " ingresa el numero de noches que se va a hospedar";
			Leer numNoches;
			costoTotal<- numNoches * 100000;
			Escribir " el costo total de la habitacion doble es:" + ConvertirATexto(costoTotal);
		Caso "F":
			Escribir " ingresa el numero de noches que se va a hospedar";
			Leer numNoches;
			costoTotal<- numNoches * 150000;
			Escribir " el costo total de la habitacion familiar es:" + ConvertirATexto(costoTotal);
		Caso "S":
			Escribir " ingresa el numero de noches que se va a hospedar";
			Leer numNoches;
			costoTotal<- numNoches * 200000;
			Escribir " el costo total de la habitacion suite es:" + ConvertirATexto(costoTotal);
		De Otro Modo:
			Escribir " tipo de habitacion no valida";
	Fin Segun
	
	
	
FinAlgoritmo

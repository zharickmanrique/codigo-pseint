Algoritmo ejercicio_9
	// Una empresa de transporte necesita un programa para calcular el precio de un viaje según el medio de transporte elegido. Las opciones son bus urbano, taxi, motocicleta de servicio público y bicicleta de alquiler. Según la opción seleccionada, el sistema deberá mostrar la tarifa establecida para cada servicio.
	Definir opciontransporte Como Caracter;
	
	Escribir "seleccione el medio de transporte para su viaje ( BU= bus urbano, T= taxi, MSP= motocicleta de servicio publico, BA= bicicleta de alquiler)";
	Leer opciontransporte;
	
	Segun opciontransporte Hacer
		caso "BU":
			Escribir " el precio del servicio es de: $4000";
		caso "T":
			Escribir " el precio del servicio es de: $8000";
		caso "MSP":
			Escribir " el precio del servicio es de: $6000";
		Caso "BA":
			Escribir " el precio del servicio es de: $5000";
		De Otro Modo:
			Escribir " transporte invalido";
	Fin Segun
	
	
FinAlgoritmo

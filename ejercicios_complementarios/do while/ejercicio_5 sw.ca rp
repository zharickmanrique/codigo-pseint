Algoritmo ejercicio_5
	// Un cine necesita un programa para que los clientes seleccionen el tipo de entrada que desean comprar. Las opciones son entrada para niño, adulto o adulto mayor. Según la opción seleccionada, el programa deberá mostrar el precio de la entrada.
	Definir tipo Como Caracter;
	
	Escribir "seleccione el tipo de entrada que desea comprar (N= niño, A= adulto, AM= adulto mayor)";
	Leer tipo;
	
	Segun tipo Hacer
		caso "N":
			Escribir " el precio de la entrada es $10000";
		caso "A":
			Escribir " el precio de la entrada es $15000";
		caso "AM":
			Escribir " el precio de la entrada es $20000";
		De Otro Modo:
			Escribir " entrada invalida";
	Fin Segun
	
	
FinAlgoritmo

Algoritmo ejercicio_1
	//un sistema debe solicitar la edad de una persona y determinar si cumple con la edad minima de 18 años para registrarse en una plataforma de trabajo
	
	Definir edad Como Entero;
	
	Escribir "ingresa tu edad";
	Leer edad;
	
	Si edad >= 18 Entonces
		Escribir " se puede registrar en la plataforma de trabajo";
	SiNo
		Escribir "no se puede registrar, la edad minima son 18 años";
	Fin Si
	
FinAlgoritmo

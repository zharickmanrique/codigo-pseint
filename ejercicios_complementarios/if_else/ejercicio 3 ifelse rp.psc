Algoritmo ejercicio_3
	// una instititucion educativa debe verificar si un estudiante completo todas las actividades de un curso para determinar si puede recibir su certificado o si debe finalizar las actividades pendientes
	
	Definir actividad Como Caracter;
	
	Escribir " el estudiante completo todas sus actividades: (si/no)";
	Leer actividad;
	Si actividad = "si" Entonces
		Escribir " puede recibir el certificado";
	SiNo
		Escribir " debe finalizar las tareas pendientes";
	Fin Si
	
FinAlgoritmo
